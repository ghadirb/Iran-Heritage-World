; Iran Heritage World - playable prototype
config_version=5

[application]
config/name="Iran Heritage World"
config/description="A Persian third-person adventure and learning game about Iranian heritage, starting with the epic of Zal and the Simorgh"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

GameState="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[gui]

theme/custom_font="res://fonts/Vazirmatn-Regular.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[internationalization]

locale/fallback="en"

[physics]

3d/default_gravity=20.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.12, 0.16, 0.2, 1)
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
